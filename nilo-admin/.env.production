# 生产环境覆盖（vite build 默认 mode=production 会自动叠加这个文件，覆盖 .env 里的同名变量）
# VITE_APP_BASE_URL 保持 '/api' 不变：相对路径，交给 nginx 按前缀转发到对应后端微服务，本地/生产都一样

# MinIO 生产环境地址（浏览器直连，必须是公网可达的域名 + HTTPS，不能再用本机测试用的 rocky13）
VITE_MINIO_ENDPOINT=https://data.nilo.video:9000
VITE_MINIO_IMAGE_BUCKET=nilo-image
VITE_MINIO_VIDEO_BUCKET=nilo-video
